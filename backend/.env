# App
APP_NAME=FamilyMan API
APP_VERSION=1.0.0
DEBUG=true
ENVIRONMENT=development

# Database - Supabase PostgreSQL (using connection pooler for public DNS resolution)
# Transaction pooler (port 6543) - recommended for serverless/server environments
# Using project-specific pooler hostname format
DATABASE_URL=postgresql+asyncpg://postgres:Royi%403millio@vbfhnsbbvjaejzozcepq.pooler.supabase.com:6543/postgres?sslmode=require

# Alternative: Session pooler (port 5432) - use if transaction pooler has issues
# DATABASE_URL=postgresql+asyncpg://postgres:Royi%403millio@vbfhnsbbvjaejzozcepq.pooler.supabase.com:5432/postgres?sslmode=require

# Alternative: Transaction pooler with region-based hostname
# DATABASE_URL=postgresql+asyncpg://postgres:Royi%403millio@aws-0-us-east-1.pooler.supabase.com:6543/postgres?sslmode=require

# JWT Keys (generate with: openssl genrsa 4096 > private.pem && openssl rsa -in private.pem -pubout > public.pem)
JWT_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nYOUR_PRIVATE_KEY_HERE\n-----END PRIVATE KEY-----"
JWT_PUBLIC_KEY="-----BEGIN PUBLIC KEY-----\nYOUR_PUBLIC_KEY_HERE\n-----END PUBLIC KEY-----"
JWT_ALGORITHM=RS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=30

# CORS
ALLOWED_ORIGINS=["http://localhost:3000", "http://localhost:8080", "http://127.0.0.1:8080"]

# Cloudflare R2
R2_ACCOUNT_ID=your_account_id
R2_ACCESS_KEY_ID=your_access_key
R2_SECRET_ACCESS_KEY=your_secret_key
R2_BUCKET=familyman-media
R2_PUBLIC_URL=https://pub-xxx.r2.dev

# Telegram Bot
TELEGRAM_BOT_TOKEN=your_bot_token_from_botfather

# FCM (Firebase Cloud Messaging)
FCM_PROJECT_ID=your_firebase_project_id
FCM_VAPID_PUBLIC_KEY=your_vapid_public_key
FCM_VAPID_PRIVATE_KEY=your_vapid_private_key

# Redis
REDIS_URL=redis://localhost:6379/0

# Render (for deployments)
RENDER_API_KEY=your_render_api_key